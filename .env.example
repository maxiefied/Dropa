# Copy this file to ".env" on your laptop. Never commit ".env" to GitHub.
DEBUG=True
SECRET_KEY=any-long-random-text-for-your-laptop

# Leave DATABASE_URL empty to use SQLite on your laptop.
# DATABASE_URL=postgres://user:password@localhost:5432/dropa

# Where uploaded files are kept. Empty means inside the project folder.
# DATA_DIR=

# Needed only when testing the site from your phone over Wi-Fi:
# ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.50

# Payments and payouts are simulated until real M-Pesa is connected.
DROPA_SIMULATE_PAYMENTS=True
